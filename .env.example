# Copy this file to .env and fill in real values. NEVER commit .env.
# BlueForge reads configuration from environment variables via src/blueforge/config.py.

# --- Enrichment API keys (optional, features degrade gracefully if unset) ---
VIRUSTOTAL_API_KEY=
ABUSEIPDB_API_KEY=

# --- Local paths ---
BLUEFORGE_LOG_DIR=./data/logs
BLUEFORGE_OUTPUT_DIR=./data/reports
GEOIP_DB_PATH=./geoip/GeoLite2-City.mmdb

# --- Wazuh (lab) ---
WAZUH_API_URL=https://192.168.1.50:55000
WAZUH_API_USER=wazuh-wui
# Do not store the password here in a shared machine; prefer a secrets manager.
WAZUH_API_PASSWORD=

# --- Microsoft Sentinel (optional, Phase 4+) ---
AZURE_TENANT_ID=
AZURE_WORKSPACE_ID=

# --- Runtime ---
LOG_LEVEL=INFO
